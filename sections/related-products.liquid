{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign related_collection = product.collections.first
-%}
{%- if related_collection != blank and related_collection.products.size > 1 -%}
  <section class="section related-products">
    <div class="page-width">
      <div class="section-heading" data-animate>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      <div class="grid-auto grid-auto--4">
        {%- assign shown = 0 -%}
        {%- for related_product in related_collection.products -%}
          {%- if related_product.id != product.id and shown < section.settings.products_to_show -%}
            {% render 'product-card', product: related_product %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
