{{ 'section-marketing.css' | asset_url | stylesheet_tag }}

<section class="section newsletter">
  <div class="page-width">
    <div class="newsletter__panel surface" data-animate>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-subtitle">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.placeholder' | t }}</label>
        <input
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="input"
          placeholder="{{ 'newsletter.placeholder' | t }}"
          required
        >
        <button type="submit" class="btn btn-primary">{{ 'newsletter.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="newsletter__message" role="status">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="newsletter__message" data-error role="alert">{{ 'newsletter.error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET THE VYRO DROP."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Be first to hear about new products, offers and setup inspiration."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
