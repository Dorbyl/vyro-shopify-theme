{{ 'section-marketing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
-%}
<section class="section spotlight">
  <div class="page-width">
    {%- if product != blank -%}
      {%- assign variant = product.selected_or_first_available_variant -%}
      <div class="spotlight__grid{% if section.settings.image_position == 'right' %} spotlight__grid--reverse{% endif %}" data-animate>
        <div class="spotlight__media">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1200 | image_tag:
              widths: '600,900,1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: product.featured_media.alt | default: product.title,
              loading: 'lazy'
            }}
          {%- else -%}
            <div class="spotlight__placeholder">{% render 'icon', name: 'image' %}</div>
          {%- endif -%}
        </div>

        <div class="spotlight__content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="spotlight__title">{{ section.settings.heading | default: product.title }}</h2>
          <p class="spotlight__description">
            {{ section.settings.description | default: product.description | strip_html | truncatewords: 40 }}
          </p>
          <div class="spotlight__price">{% render 'price', product: product, variant: variant %}</div>

          {%- if section.blocks.size > 0 -%}
            <ul class="spotlight__benefits" role="list">
              {%- for block in section.blocks -%}
                <li class="spotlight__benefit" {{ block.shopify_attributes }}>
                  {% render 'icon', name: 'check' %}
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="hero__actions">
            {%- if product.available -%}
              <button type="button" class="btn btn-primary" data-add-to-cart data-variant-id="{{ variant.id }}">
                {{ 'products.product.add_to_cart' | t }}
              </button>
            {%- else -%}
              <span class="btn btn-primary" aria-disabled="true" style="opacity:.5;pointer-events:none;">{{ 'products.product.sold_out' | t }}</span>
            {%- endif -%}
            <a href="{{ product.url }}" class="btn btn-secondary">{{ 'products.product.view_details' | t }}</a>
          </div>
        </div>
      </div>
    {%- else -%}
      <p style="text-align:center; color: var(--color-text-secondary);">Select a product in the theme editor to feature it here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "FEATURED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override (optional)"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description override (optional)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Adjustable, stable and built to last"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "benefit", "settings": { "text": "Adjustable to your ideal angle and height" } },
      { "type": "benefit", "settings": { "text": "Stable, non-slip design for laptop and phone" } },
      { "type": "benefit", "settings": { "text": "Compact and portable for study or studio" } }
    ]
  },
  "presets": [
    {
      "name": "Featured product"
    }
  ]
}
{% endschema %}
