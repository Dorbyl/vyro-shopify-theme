{{ 'template-page.css' | asset_url | stylesheet_tag }}

<div class="page-width error-404">
  <span class="error-404__code">404</span>
  <h1 class="error-404__title">{{ '404.title' | t }}</h1>
  <p class="error-404__text">{{ '404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="btn btn-primary error-404__link">{{ '404.link' | t }}</a>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": []
}
{% endschema %}
