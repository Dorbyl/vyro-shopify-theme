{{ 'section-marketing.css' | asset_url | stylesheet_tag }}

<section class="section testimonials">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="section-heading section-heading--center" data-animate>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      <div class="testimonials__grid">
        {%- for block in section.blocks -%}
          <div class="testimonial-card surface" data-animate {{ block.shopify_attributes }}>
            <p class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <p class="testimonial-card__author">{{ block.settings.author }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="testimonials__brand-message" data-animate>
        <span class="eyebrow">{{ section.settings.eyebrow | default: 'VYRO' }}</span>
        <h2 class="section-title">{{ section.settings.brand_message }}</h2>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (shown with brand message)",
      "default": "VYRO"
    },
    {
      "type": "text",
      "id": "brand_message",
      "label": "Brand message (shown when no reviews are added)",
      "default": "YOUR SETUP STARTS HERE."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (shown when reviews are added)",
      "default": "WHAT PEOPLE ARE SAYING"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
