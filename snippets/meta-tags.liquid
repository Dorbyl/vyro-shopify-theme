{%- comment -%} SEO meta tags: title, description, canonical, Open Graph, Twitter card {%- endcomment -%}
{%- liquid
  assign seo_title = page_title | default: shop.name
  if current_tags
    assign seo_title = seo_title | append: ' – tagged "' | append: current_tags | join: ', ' | append: '"'
  endif
  if current_page != 1
    assign seo_title = seo_title | append: ' – Page ' | append: current_page
  endif

  assign seo_description = page_description | default: shop.description | default: 'Smart tech and desk essentials for students and creators. South African delivery.'

  assign seo_image = page_image | default: settings.share_image
-%}
<title>{{ seo_title }}{% unless seo_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
<meta name="description" content="{{ seo_description | strip_html | truncate: 320 }}">
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:description" content="{{ seo_description | strip_html | truncate: 320 }}">
<meta property="og:type" content="{% if template == 'product' %}product{% else %}website{% endif %}">
{%- if seo_image %}
  <meta property="og:image" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:secure_url" content="https:{{ seo_image | image_url: width: 1200 }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title }}">
<meta name="twitter:description" content="{{ seo_description | strip_html | truncate: 320 }}">
{%- if seo_image %}
  <meta name="twitter:image" content="https:{{ seo_image | image_url: width: 1200 }}">
{%- endif %}
