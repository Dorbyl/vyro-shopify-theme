<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- render 'meta-tags' -%}
    {%- render 'structured-data' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <style>
      {%- render 'css-variables' -%}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-header.css' | asset_url | stylesheet_tag }}
    {{ 'component-footer.css' | asset_url | stylesheet_tag }}
    {{ 'component-cart.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}" data-cart-type="{{ settings.cart_type }}">
    <a class="skip-to-content-link btn btn-primary" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    <script>
      window.routes = {
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        cartUpdateUrl: {{ routes.cart_update_url | json }},
        cartUrl: {{ routes.cart_url | json }}
      };
      window.cartStrings = {
        error: {{ 'general.cart.update_error' | t | json }}
      };
      window.moneyFormat = {{ shop.money_format | json }};
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {%- section 'announcement-bar' -%}
    {%- section 'header' -%}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- section 'footer' -%}
    {%- section 'cart-drawer' -%}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- if template contains 'product' -%}
      <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
